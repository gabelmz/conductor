#!/bin/sh
# Permanent pre-push guard for the conductor repo (wired via core.hooksPath).
#
# Rules:
#   1. refs/heads/main is RELEASE-ONLY. A push to main is allowed only when
#      the same push carries a refs/tags/v* tag, or HEAD is exactly tagged v*.
#      Violators are blocked with a hint to push to staging instead.
#   2. A release push (main + v* tag) MUST have a CHANGELOG.md at HEAD that
#      mentions the released version. Changelogs are authored by SILENT
#      SUBAGENTS ONLY (delegate_task) - never hand-written in chat.
# Every other branch (staging, features) pushes normally.
#
# POSIX sh on purpose: GUI git clients (VS Code, the Claude desktop app) run
# hooks with a PATH that has no `bash`, so a `#!/usr/bin/env bash` shebang
# dies with "/usr/bin/env: 'bash': No such file or directory" and blocks every
# push. Keep this script free of bash-isms (arrays, declare, [[ ]]).

set -u

pushing_main=0
tag_in_push=0
tag_ver=""
main_sha=""

while IFS=' ' read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "${local_ref:-}" ] && continue
  case "$local_ref" in
    refs/heads/main) pushing_main=1; main_sha="$local_sha" ;;
    refs/tags/v*)    tag_in_push=1; tag_ver=${local_ref#refs/tags/v} ;;
  esac
done

[ "$pushing_main" = "0" ] && exit 0

# --- main push: must be a release push (v* tag) ---
if [ "$tag_in_push" = "1" ]; then
  ver="$tag_ver"
elif git describe --tags --exact-match "$main_sha" >/dev/null 2>&1 \
     && git describe --tags --exact-match "$main_sha" | grep -q '^v'; then
  ver=$(git describe --tags --exact-match "$main_sha" | sed 's/^v//')
else
  echo ""
  echo "main is release-only: this push carries no v* release tag (and HEAD is not tagged)."
  echo "   Push your branch to staging instead:"
  echo "      git push origin HEAD:staging"
  echo ""
  exit 1
fi

# --- release push: changelog must exist and mention the version ---
if ! git show "HEAD:CHANGELOG.md" 2>/dev/null | grep -qE "(^|[^0-9])${ver}([^0-9]|$)"; then
  echo ""
  echo "release v${ver} has no CHANGELOG.md entry at HEAD."
  echo "   Changelogs are written by SILENT SUBAGENTS ONLY - dispatch one:"
  echo "      delegate_task -> 'write CHANGELOG.md entry for v${ver} from git log v<prev>..HEAD'"
  echo "   Then commit CHANGELOG.md and retry the push."
  echo ""
  exit 1
fi
